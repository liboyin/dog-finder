[Unit]
Description=Refresh the dog-finder adoption index
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Code/dog-finder
ExecStart=%h/Code/dog-finder/scripts/daily-refresh.sh
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=90min
